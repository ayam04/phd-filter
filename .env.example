# Gemini (Google AI Studio key). Required for live runs.
GOOGLE_API_KEY=your-google-ai-studio-key
GEMINI_MODEL=gemini-2.0-flash
EMBED_MODEL=text-embedding-004

# OpenAlex "polite pool" — put any contact email here for faster, more reliable access.
OPENALEX_MAILTO=you@example.com

# Optional overrides
